# Mahfooz Balakot - Environment Configuration Template
# Copy this file to .env and configure your keys

# CARTO Basemaps API Key & Tile URL
CARTO_API_KEY=your_carto_api_key_here
CARTO_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=your_carto_api_key_here

# Frontend Vite Prefix
VITE_CARTO_API_KEY=your_carto_api_key_here
VITE_CARTO_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=your_carto_api_key_here

# Application Server Settings
PORT=5173
NODE_ENV=development

# Geographic Defaults (Balakot, KP)
MAP_CENTER_LAT=34.5484
MAP_CENTER_LNG=73.3533
MAP_DEFAULT_ZOOM=14
